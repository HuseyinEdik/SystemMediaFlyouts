<UserControl x:Class="SystemMediaFlyouts.Views.BrightnessUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid Margin="0,5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="40" />
        </Grid.ColumnDefinitions>

        <ui:SymbolIcon Symbol="BrightnessHigh24" FontSize="20" Grid.Column="0" Margin="0,0,15,0"/>
        <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding CurrentBrightness, Mode=TwoWay}" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="2" Text="{Binding CurrentBrightness}" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="SemiBold"/>
    </Grid>
</UserControl>