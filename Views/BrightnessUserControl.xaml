<UserControl x:Class="SystemMediaFlyouts.Views.BrightnessUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid Margin="0,5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="30"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="30"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0" Text="&#xE706;" FontFamily="Segoe Fluent Icons" FontSize="20" 
                   Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}" 
                   VerticalAlignment="Center" HorizontalAlignment="Center"/>

        <Slider Grid.Column="1" Value="{Binding CurrentBrightness}" Maximum="100" 
                VerticalAlignment="Center" Margin="10,0,10,0"/>

        <TextBlock Grid.Column="2" Text="{Binding CurrentBrightness}" 
                   Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
                   VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="14"/>
    </Grid>
</UserControl>