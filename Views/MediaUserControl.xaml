<UserControl x:Class="SystemMediaFlyouts.Views.MediaUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid Margin="0,5,0,15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="60"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border CornerRadius="8" Width="60" Height="60" ClipToBounds="True" Background="#33000000">
            <Image Source="{Binding MediaThumbnail}" Stretch="UniformToFill"/>
        </Border>

        <StackPanel Grid.Column="1" Margin="15,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding MediaTitle}" 
                       Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}" 
                       FontWeight="Bold" FontSize="14" TextTrimming="CharacterEllipsis"/>

            <TextBlock Text="{Binding MediaArtist}" 
                       Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" 
                       FontSize="12" Margin="0,2,0,8" TextTrimming="CharacterEllipsis"/>

            <ProgressBar Value="{Binding MediaProgress}" Maximum="100" Height="4" Margin="0,0,0,10" Foreground="{ui:ThemeResource SystemAccentColorPrimaryBrush}"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <ui:Button Command="{Binding SkipPreviousCommand}" Icon="{ui:SymbolIcon Previous24}" Appearance="Secondary" Margin="0,0,5,0"/>

                <ui:Button Command="{Binding TogglePlayPauseCommand}" Icon="{ui:SymbolIcon Play24}" Appearance="Primary" Margin="0,0,5,0"/>

                <ui:Button Command="{Binding SkipNextCommand}" Icon="{ui:SymbolIcon Next24}" Appearance="Secondary"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>