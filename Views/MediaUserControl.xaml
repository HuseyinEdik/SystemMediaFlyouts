<UserControl x:Class="SystemMediaFlyouts.Views.MediaUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Width="60" Height="60" CornerRadius="6" Margin="0,0,12,0"
                    Background="{ui:ThemeResource ControlAltFillColorSecondaryBrush}">
                <Border.OpacityMask>
                    <VisualBrush>
                        <VisualBrush.Visual>
                            <Border Width="60" Height="60" CornerRadius="6" Background="Black"/>
                        </VisualBrush.Visual>
                    </VisualBrush>
                </Border.OpacityMask>
                <Image Source="{Binding MediaThumbnail}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding MediaTitle}" 
                           Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}" 
                           FontWeight="Bold" FontSize="14" TextTrimming="CharacterEllipsis"/>

                <TextBlock Text="{Binding MediaArtist}" 
                           Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" 
                           FontSize="12" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="{Binding CurrentPositionString}" 
                       Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" 
                       FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>

            <Slider Grid.Column="1" Minimum="0" 
                    Maximum="{Binding TotalDurationSeconds}" 
                    Value="{Binding CurrentPositionSeconds}"
                    VerticalAlignment="Center"/>

            <TextBlock Grid.Column="2" Text="{Binding TotalDurationString}" 
                       Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" 
                       FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">

            <ui:Button Command="{Binding SkipPreviousCommand}" Icon="{ui:SymbolIcon Previous24}" 
                       Appearance="Transparent" Margin="0,0,12,0" Padding="10,8"/>

            <ui:Button Command="{Binding TogglePlayPauseCommand}" Appearance="Transparent" Margin="0,0,12,0" Padding="12,8">
                <Grid>
                    <ui:SymbolIcon Symbol="Play24" Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}">
                        <ui:SymbolIcon.Style>
                            <Style TargetType="ui:SymbolIcon">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMediaPlaying}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:SymbolIcon.Style>
                    </ui:SymbolIcon>

                    <ui:SymbolIcon Symbol="Pause24" Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}">
                        <ui:SymbolIcon.Style>
                            <Style TargetType="ui:SymbolIcon">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMediaPlaying}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:SymbolIcon.Style>
                    </ui:SymbolIcon>
                </Grid>
            </ui:Button>

            <ui:Button Command="{Binding SkipNextCommand}" Icon="{ui:SymbolIcon Next24}" 
                       Appearance="Transparent" Padding="10,8"/>
        </StackPanel>
    </Grid>
</UserControl>