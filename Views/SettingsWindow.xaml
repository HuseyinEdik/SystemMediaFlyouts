<ui:FluentWindow x:Class="SystemMediaFlyouts.Views.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Ayarlar" Height="550" Width="750"
                 WindowStartupLocation="CenterScreen"
                 ResizeMode="NoResize"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="System Media Flyouts Ayarları" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="{ui:ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="0,0,1,0" Padding="10,15,10,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Ayarlar" FontSize="14" FontWeight="SemiBold" Margin="10,0,0,15" Opacity="0.7"/>

                    <StackPanel Grid.Row="1">
                        <ui:Button Content="Görünüm ve Konum" 
                                   Command="{Binding NavigateCommand}" CommandParameter="Appearance"
                                   HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,0,0,5"
                                   Appearance="Transparent"/>

                        <ui:Button Content="Modül Görünürlüğü"
                                   Command="{Binding NavigateCommand}" CommandParameter="Visibility"
                                   HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,0,0,5"
                                   Appearance="Transparent"/>
                    </StackPanel>

                    <ui:Button Grid.Row="2" Content="Hakkında" Icon="{ui:SymbolIcon Info24}"
                               Command="{Binding NavigateCommand}" CommandParameter="About"
                               HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                               Appearance="Transparent"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <Grid Margin="25,15,25,25">

                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPage}" Value="Appearance">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <TextBlock Text="Görünüm ve Konum" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,20"/>

                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="Uygulama Teması" FontWeight="Medium"/>
                                    <TextBlock Text="Açık, Koyu veya Sistem temasını seçin." FontSize="12" Opacity="0.7"/>
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ComboBox ItemsSource="{Binding AvailableThemes}" 
                                      DisplayMemberPath="Value" 
                                      SelectedValuePath="Key" 
                                      SelectedValue="{Binding Theme, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                      Width="150"/>
                        </ui:CardControl>

                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="Panel Konumu" FontWeight="Medium"/>
                                    <TextBlock Text="Gösterge panelinin ekranda çıkacağı köşeyi belirleyin." FontSize="12" Opacity="0.7"/>
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ComboBox ItemsSource="{Binding AvailablePositions}" 
                                      DisplayMemberPath="Value" 
                                      SelectedValuePath="Key" 
                                      SelectedValue="{Binding Position, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                      Width="150"/>
                        </ui:CardControl>

                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="Gösterim Süresi" FontWeight="Medium"/>
                                    <TextBlock Text="Panelin ekranda kalacağı süre (saniye)" FontSize="12" Opacity="0.7"/>
                                </StackPanel>
                            </ui:CardControl.Header>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Slider Minimum="1" Maximum="10" Value="{Binding DisplayDuration, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="120" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding DisplayDuration}" VerticalAlignment="Center" FontWeight="SemiBold" Width="15"/>
                                <TextBlock Text="sn" VerticalAlignment="Center" Opacity="0.7"/>
                            </StackPanel>
                        </ui:CardControl>
                    </StackPanel>

                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPage}" Value="Visibility">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <TextBlock Text="Modül Görünürlüğü" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,20"/>

                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Play24" Margin="0,0,10,0"/>
                                    <StackPanel>
                                        <TextBlock Text="Medya Modülü" FontWeight="Medium"/>
                                        <TextBlock Text="Şarkı bilgisi ve kontrolleri göster" FontSize="12" Opacity="0.7"/>
                                    </StackPanel>
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch IsChecked="{Binding IsMediaModuleEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </ui:CardControl>

                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Speaker224" Margin="0,0,10,0"/>
                                    <StackPanel>
                                        <TextBlock Text="Ses Modülü" FontWeight="Medium"/>
                                        <TextBlock Text="Sistem ses seviyesi kontrolünü göster" FontSize="12" Opacity="0.7"/>
                                    </StackPanel>
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch IsChecked="{Binding IsVolumeModuleEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </ui:CardControl>

                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="BrightnessHigh24" Margin="0,0,10,0"/>
                                    <StackPanel>
                                        <TextBlock Text="Parlaklık Modülü" FontWeight="Medium"/>
                                        <TextBlock Text="Ekran parlaklığı kontrolünü göster" FontSize="12" Opacity="0.7"/>
                                    </StackPanel>
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch IsChecked="{Binding IsBrightnessModuleEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </ui:CardControl>
                    </StackPanel>

                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPage}" Value="About">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <TextBlock Text="Hakkında" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,20"/>

                        <Border Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}" 
                                BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}" 
                                BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock Text="SystemMediaFlyouts" FontSize="18" FontWeight="Bold" Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding AppVersion}" FontSize="12" Opacity="0.7" Margin="0,0,0,15"/>

                                <TextBlock Text="Windows medya oturumlarını ve sistem ses/parlaklık kontrollerini zarif bir şekilde yöneten açık kaynaklı gösterge paneli uygulaması." 
                                           TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,20"/>

                                <ui:Button Content="GitHub Proje Sayfası" Icon="{ui:SymbolIcon Share24}" 
                                           Appearance="Primary" Command="{Binding OpenGitHubCommand}" 
                                           HorizontalAlignment="Left" Padding="15,6"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{ui:ThemeResource CardBackgroundFillColorSecondaryBrush}" 
                                BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}" 
                                BorderThickness="1" CornerRadius="8" Padding="20">
                            <StackPanel>

                                <TextBlock Text="Hataları Bize Bildirin" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>

                                <TextBlock Text="Uygulamayı kullanırken can sıkıcı bir hatayla mı karşılaştınız veya harika bir özellik fikriniz mi var? Geliştirmemize yardımcı olmak için lütfen GitHub üzerinden bir kayıt oluşturun." 
                                           TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,20" Opacity="0.8"/>

                                <ui:Button Content="Hata Bildir" Icon="{ui:SymbolIcon Open24}" 
                                           Appearance="Primary" Command="{Binding OpenGitHubIssuesCommand}" 
                                           HorizontalAlignment="Left" Padding="15,6"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</ui:FluentWindow>