<ui:FluentWindow x:Class="SystemMediaFlyouts.Views.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="{DynamicResource Lang_SettingsWindowTitle}" Height="550" Width="750"
                 WindowStartupLocation="CenterScreen"
                 ResizeMode="NoResize"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{DynamicResource Lang_SettingsWindowTitle}" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="{ui:ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="0,0,1,0" Padding="10,15,10,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{DynamicResource Lang_MenuHeader}" FontSize="14" FontWeight="SemiBold" Margin="10,0,0,15" Opacity="0.7"/>

                    <StackPanel Grid.Row="1">
                        <ui:Button Content="{DynamicResource Lang_MenuGeneral}" 
                                   Command="{Binding NavigateCommand}" CommandParameter="General"
                                   HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,0,0,5"
                                   Appearance="Transparent"/>

                        <ui:Button Content="{DynamicResource Lang_MenuAppearance}" 
                                   Command="{Binding NavigateCommand}" CommandParameter="Appearance"
                                   HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,0,0,5"
                                   Appearance="Transparent"/>

                        <ui:Button Content="{DynamicResource Lang_MenuVisibility}" 
                                   Command="{Binding NavigateCommand}" CommandParameter="Visibility"
                                   HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,0,0,5"
                                   Appearance="Transparent"/>
                    </StackPanel>

                    <ui:Button Grid.Row="2" Content="{DynamicResource Lang_MenuAbout}" Icon="{ui:SymbolIcon Info24}"
                               Command="{Binding NavigateCommand}" CommandParameter="About"
                               HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                               Appearance="Transparent"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <Grid Margin="25,15,25,25">

                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPage}" Value="General">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <TextBlock Text="{DynamicResource Lang_GeneralTitle}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,20"/>

                        <TextBlock Text="{DynamicResource Lang_SystemSection}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10" Opacity="0.6"/>

                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Lang_RunAtStartup}" FontWeight="Medium"/>
                                    <TextBlock Text="{DynamicResource Lang_RunAtStartupDesc}" FontSize="12" Opacity="0.7"/>
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch IsChecked="{Binding IsRunAtStartupEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </ui:CardControl>

                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Lang_AppLanguage}" FontWeight="Medium"/>
                                    <TextBlock Text="{DynamicResource Lang_AppLanguageDesc}" FontSize="12" Opacity="0.7"/>
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ComboBox ItemsSource="{Binding AvailableLanguages}" 
                                      DisplayMemberPath="Value" 
                                      SelectedValuePath="Key" 
                                      SelectedValue="{Binding Language, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                      Width="150"/>
                        </ui:CardControl>

                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Lang_PanelPosition}" FontWeight="Medium"/>
                                    <TextBlock Text="{DynamicResource Lang_PanelPositionDesc}" FontSize="12" Opacity="0.7"/>
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ComboBox ItemsSource="{Binding AvailablePositions}" 
                                      DisplayMemberPath="DisplayName" 
                                      SelectedValuePath="Key" 
                                      SelectedValue="{Binding Position, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                      Width="150"/>
                        </ui:CardControl>
                    </StackPanel>

                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPage}" Value="Appearance">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <TextBlock Text="{DynamicResource Lang_AppearanceTitle}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,20"/>

                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Lang_AppTheme}" FontWeight="Medium"/>
                                    <TextBlock Text="{DynamicResource Lang_AppThemeDesc}" FontSize="12" Opacity="0.7"/>
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ComboBox ItemsSource="{Binding AvailableThemes}" 
                                      DisplayMemberPath="DisplayName" 
                                      SelectedValuePath="Key" 
                                      SelectedValue="{Binding Theme, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                      Width="150"/>
                        </ui:CardControl>

                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Lang_PanelScale}" FontWeight="Medium"/>
                                    <TextBlock Text="{DynamicResource Lang_PanelScaleDesc}" FontSize="12" Opacity="0.7"/>
                                </StackPanel>
                            </ui:CardControl.Header>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Slider Width="150" 
                                        Minimum="0.50" 
                                        Maximum="1.50" 
                                        TickFrequency="0.05"
                                        IsSnapToTickEnabled="True"
                                        IsMoveToPointEnabled="True" 
                                        Value="{Binding PanelScale, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        VerticalAlignment="Center" 
                                        Margin="0,0,15,0"/>

                                <TextBlock Text="{Binding PanelScale, StringFormat={}{0:P0}}" 
                                           Width="40" 
                                           TextAlignment="Right" 
                                           VerticalAlignment="Center" 
                                           FontWeight="SemiBold"
                                           Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </ui:CardControl>

                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Lang_DisplayDuration}" FontWeight="Medium"/>
                                    <TextBlock Text="{DynamicResource Lang_DisplayDurationDesc}" FontSize="12" Opacity="0.7"/>
                                </StackPanel>
                            </ui:CardControl.Header>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Slider Width="150" 
                                        Minimum="1" 
                                        Maximum="10" 
                                        IsMoveToPointEnabled="True"
                                        Value="{Binding DisplayDuration, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                        VerticalAlignment="Center" 
                                        Margin="0,0,15,0"/>

                                <TextBlock Width="40" 
                                           TextAlignment="Right"
                                           VerticalAlignment="Center" 
                                           FontWeight="SemiBold" 
                                           Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}">
                                    <Run Text="{Binding DisplayDuration}"/>
                                    <Run Text=" "/>
                                    <Run Text="{DynamicResource Lang_SecondsSuffix}"/>
                                </TextBlock>
                            </StackPanel>
                        </ui:CardControl>
                    </StackPanel>

                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPage}" Value="Visibility">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <TextBlock Text="{DynamicResource Lang_VisibilityTitle}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,20"/>

                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Settings24" Margin="0,0,10,0"/>
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Lang_ControlBarModule}" FontWeight="Medium"/>
                                        <TextBlock Text="{DynamicResource Lang_ControlBarModuleDesc}" FontSize="12" Opacity="0.7"/>
                                    </StackPanel>
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch IsChecked="{Binding IsControlBarEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </ui:CardControl>

                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Play24" Margin="0,0,10,0"/>
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Lang_MediaModule}" FontWeight="Medium"/>
                                        <TextBlock Text="{DynamicResource Lang_MediaModuleDesc}" FontSize="12" Opacity="0.7"/>
                                    </StackPanel>
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch IsChecked="{Binding IsMediaModuleEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </ui:CardControl>

                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Speaker224" Margin="0,0,10,0"/>
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Lang_VolumeModule}" FontWeight="Medium"/>
                                        <TextBlock Text="{DynamicResource Lang_VolumeModuleDesc}" FontSize="12" Opacity="0.7"/>
                                    </StackPanel>
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch IsChecked="{Binding IsVolumeModuleEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </ui:CardControl>

                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="BrightnessHigh24" Margin="0,0,10,0"/>
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Lang_BrightnessModule}" FontWeight="Medium"/>
                                        <TextBlock Text="{DynamicResource Lang_BrightnessModuleDesc}" FontSize="12" Opacity="0.7"/>
                                    </StackPanel>
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch IsChecked="{Binding IsBrightnessModuleEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </ui:CardControl>
                    </StackPanel>

                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPage}" Value="About">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <TextBlock Text="{DynamicResource Lang_AboutTitle}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,20"/>

                        <Border Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}" 
                                BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}" 
                                BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Lang_AppName}" FontSize="18" FontWeight="Bold" Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding AppVersion}" FontSize="12" Opacity="0.7" Margin="0,0,0,15"/>

                                <TextBlock Text="{DynamicResource Lang_AboutDesc}" 
                                           TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,20"/>

                                <ui:Button Content="{DynamicResource Lang_GitHubProjectPage}" Icon="{ui:SymbolIcon Share24}" 
                                           Appearance="Primary" Command="{Binding OpenGitHubCommand}" 
                                           HorizontalAlignment="Left" Padding="15,6"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{ui:ThemeResource CardBackgroundFillColorSecondaryBrush}" 
                                BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}" 
                                BorderThickness="1" CornerRadius="8" Padding="20">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Lang_ReportBugsTitle}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <TextBlock Text="{DynamicResource Lang_ReportBugsDesc}" 
                                           TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,20" Opacity="0.8"/>
                                <ui:Button Content="{DynamicResource Lang_ReportBugsButton}" Icon="{ui:SymbolIcon Open24}" 
                                           Appearance="Primary" Command="{Binding OpenGitHubIssuesCommand}" 
                                           HorizontalAlignment="Left" Padding="15,6"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</ui:FluentWindow>